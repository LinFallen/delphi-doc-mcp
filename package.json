{
  "name": "delphi-doc-mcp",
  "version": "1.0.0",
  "description": "MCP server for Delphi documentation (RAD Studio VCL & DevExpress VCL)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "delphi-doc-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "crawl:devexpress": "tsx src/crawler/run-devexpress.ts",
    "crawl:vcl": "tsx src/crawler/run-vcl.ts",
    "crawl:fpc": "tsx src/crawler/run-fpc.ts",
    "index:build": "tsx src/indexer/build-index.ts",
    "test": "vitest",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "delphi",
    "vcl",
    "devexpress",
    "documentation",
    "ai",
    "claude"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "fs-extra": "^11.2.0",
    "lunr": "^2.3.9",
    "puppeteer": "^24.34.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/lunr": "^2.3.7",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}