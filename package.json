{
  "name": "delphi-doc-mcp",
  "version": "1.0.2",
  "description": "MCP server for Delphi documentation (DevExpress VCL & Free Pascal RTL)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "delphi-doc-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh.md",
    "doc"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "tsx src/index.ts",
    "crawl:devexpress": "tsx src/crawler/run-devexpress.ts",
    "crawl:vcl": "tsx src/crawler/run-vcl.ts",
    "crawl:fpc": "tsx src/crawler/run-fpc.ts",
    "index:build": "tsx src/indexer/build-index.ts",
    "test": "vitest",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "delphi",
    "vcl",
    "devexpress",
    "freepascal",
    "documentation",
    "ai",
    "claude",
    "llm"
  ],
  "author": "LinFallen",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LinFallen/delphi-doc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/LinFallen/delphi-doc-mcp/issues"
  },
  "homepage": "https://github.com/LinFallen/delphi-doc-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "fs-extra": "^11.2.0",
    "lunr": "^2.3.9"
  },
  "optionalDependencies": {
    "puppeteer": "^24.34.0"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/lunr": "^2.3.7",
    "@types/node": "^20.10.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
